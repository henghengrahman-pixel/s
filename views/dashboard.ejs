<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Dashboard</title>
<style>
body{margin:0;font-family:Arial;background:#0f172a;color:#fff;display:flex}
.sidebar{width:220px;background:#020617;height:100vh;padding:20px}
.menu a{display:block;padding:10px;margin:5px 0;color:#94a3b8;text-decoration:none;border-radius:6px}
.menu a.active,.menu a:hover{background:#1e293b;color:#fff}
.main{flex:1;padding:20px}
.tab{display:none}
.tab.active{display:block}
.card{background:#1e293b;padding:15px;border-radius:10px;margin-bottom:15px}
</style>
</head>
<body>

<div class="sidebar">
<h2>PANEL</h2>
<div class="menu">
<a onclick="openTab('dashboard')" class="active">Dashboard</a>
<a onclick="openTab('staff')">Staff</a>
<a onclick="openTab('case')">Case</a>
<a onclick="openTab('akun')">Akun</a>
</div>
</div>

<div class="main">

<div id="dashboard" class="tab active">
<div class="card">Total Staff: <%= staff.length %></div>
<div class="card">Total Case: <%= cases.length %></div>
</div>

<div id="staff" class="tab">
<div class="card">
<form method="POST" action="/add/staff">
<input name="nama" placeholder="Nama">
<button>Tambah</button>
</form>
<% staff.forEach((s,i)=>{ %>
<div><%= s.nama %>
<form method="POST" action="/delete/staff">
<input type="hidden" name="index" value="<%= i %>">
<button>Hapus</button>
</form>
</div>
<% }) %>
</div>
</div>

<div id="case" class="tab">
<div class="card">
<form method="POST" action="/add/cases">
<input name="case" placeholder="Case">
<button>Tambah</button>
</form>
<% cases.forEach((c,i)=>{ %>
<div><%= c.case %>
<form method="POST" action="/delete/cases">
<input type="hidden" name="index" value="<%= i %>">
<button>Hapus</button>
</form>
</div>
<% }) %>
</div>
</div>

<div id="akun" class="tab">
<div class="card">
<form method="POST" action="/add/akun">
<input name="id" placeholder="ID">
<input name="psw" placeholder="Password">
<button>Tambah</button>
</form>
<% akun.forEach((a,i)=>{ %>
<div><%= a.id %>
<form method="POST" action="/delete/akun">
<input type="hidden" name="index" value="<%= i %>">
<button>Hapus</button>
</form>
</div>
<% }) %>
</div>
</div>

</div>

<script>
function openTab(id){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');

  document.querySelectorAll('.menu a').forEach(a=>a.classList.remove('active'));
  event.target.classList.add('active');
}
</script>

</body>
</html>
