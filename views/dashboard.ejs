<!DOCTYPE html>
<html>
<body>
<h1>DASHBOARD</h1>

<h2>Tambah Staff</h2>
<form method="POST" action="/add/staff">
<input name="nama">
<button>Tambah</button>
</form>

<h2>Staff</h2>
<% staff.forEach(s=>{ %>
<div><%= s.nama %></div>
<% }) %>

<h2>Case</h2>
<form method="POST" action="/add/case">
<input name="case">
<button>Tambah</button>
</form>

<% case.forEach((c,i)=>{ %>
<div>
<%= c.case %> - <%= c.status||'BELUM' %>
<form method="POST" action="/update-case">
<input type="hidden" name="index" value="<%= i %>">
<select name="status">
<option>SELESAI</option>
<option>BELUM</option>
</select>
<input name="note">
<button>Update</button>
</form>
</div>
<% }) %>

</body>
</html>
