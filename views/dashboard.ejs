<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Kantor</title>

<style>
body{
  margin:0;
  font-family:Arial;
  background:#0f172a;
  color:#fff;
  display:flex;
}

/* SIDEBAR */
.sidebar{
  width:220px;
  background:#020617;
  height:100vh;
  padding:20px;
}

.sidebar h2{
  margin-bottom:20px;
}

.menu a{
  display:block;
  padding:10px;
  margin:5px 0;
  text-decoration:none;
  color:#94a3b8;
  border-radius:8px;
}

.menu a:hover{
  background:#1e293b;
  color:#fff;
}

/* MAIN */
.main{
  flex:1;
  padding:20px;
}

/* CARD */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:15px;
}

.card{
  background:#1e293b;
  padding:15px;
  border-radius:12px;
}

/* FORM */
input,select{
  width:100%;
  padding:8px;
  margin:5px 0;
  border:none;
  border-radius:6px;
  background:#0f172a;
  color:#fff;
}

button{
  padding:8px;
  border:none;
  border-radius:6px;
  background:#22c55e;
  cursor:pointer;
  margin-top:5px;
}

.delete{
  background:#ef4444;
}

/* STATUS */
.status-belum{color:#facc15;}
.status-selesai{color:#4ade80;}

.scroll{
  max-height:200px;
  overflow:auto;
}
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <h2>🏢 PANEL</h2>

  <div class="menu">
    <a href="#">Dashboard</a>
    <a href="#">Staff</a>
    <a href="#">Rekening</a>
    <a href="#">Masalah</a>
    <a href="#">SP Staff</a>
  </div>
</div>

<!-- MAIN -->
<div class="main">

<h1>🔥 Dashboard Kantor</h1>

<div class="grid">

<!-- STAT -->
<div class="card">
<h3>Total Staff</h3>
<h2><%= staff.length %></h2>
</div>

<div class="card">
<h3>Total Case</h3>
<h2><%= cases.length %></h2>
</div>

<div class="card">
<h3>Belum Selesai</h3>
<h2>
<%= cases.filter(c=>!c.status || c.status==='BELUM').length %>
</h2>
</div>

</div>

<br>

<div class="grid">

<!-- STAFF PAGI -->
<div class="card">
<h3>Staff Pagi</h3>

<form method="POST" action="/add/staff">
<input name="nama" placeholder="Nama">
<input type="hidden" name="shift" value="PAGI">

<select name="jobdesk">
<option>DEPO</option>
<option>WD</option>
<option>LIVECHAT</option>
</select>

<button>Tambah</button>
</form>

<div class="scroll">
<% staff.filter(s=>s.shift==='PAGI').forEach((s,i)=>{ %>
<div>
<%= s.nama %> - <%= s.jobdesk %>

<form method="POST" action="/delete/staff">
<input type="hidden" name="index" value="<%= i %>">
<button class="delete">Hapus</button>
</form>

</div>
<% }) %>
</div>
</div>

<!-- STAFF MALAM -->
<div class="card">
<h3>Staff Malam</h3>

<form method="POST" action="/add/staff">
<input name="nama" placeholder="Nama">
<input type="hidden" name="shift" value="MALAM">

<select name="jobdesk">
<option>DEPO</option>
<option>WD</option>
<option>LIVECHAT</option>
</select>

<button>Tambah</button>
</form>

<div class="scroll">
<% staff.filter(s=>s.shift==='MALAM').forEach((s,i)=>{ %>
<div>
<%= s.nama %> - <%= s.jobdesk %>

<form method="POST" action="/delete/staff">
<input type="hidden" name="index" value="<%= i %>">
<button class="delete">Hapus</button>
</form>

</div>
<% }) %>
</div>
</div>

<!-- CASE -->
<div class="card">
<h3>Case Masalah</h3>

<form method="POST" action="/add/cases">
<input name="case" placeholder="Masalah">
<button>Tambah</button>
</form>

<div class="scroll">
<% cases.forEach((c,i)=>{ %>
<div>

<b><%= c.case %></b><br>

<span class="<%= c.status==='SELESAI'?'status-selesai':'status-belum' %>">
<%= c.status || 'BELUM' %>
</span>

<form method="POST" action="/update-case">
<input type="hidden" name="index" value="<%= i %>">

<select name="status">
<option>SELESAI</option>
<option>BELUM</option>
</select>

<input name="note" placeholder="Note">
<button>Update</button>
</form>

<form method="POST" action="/delete-case">
<input type="hidden" name="index" value="<%= i %>">
<button class="delete">Hapus</button>
</form>

</div>
<% }) %>
</div>
</div>

<!-- AKUN -->
<div class="card">
<h3>Data Akun</h3>

<form method="POST" action="/add/akun">
<input name="id" placeholder="ID">
<input name="psw" placeholder="Password">
<button>Tambah</button>
</form>

<div class="scroll">
<% akun.forEach((a,i)=>{ %>
<div>
<%= a.id %> - <%= a.psw %>

<form method="POST" action="/delete/akun">
<input type="hidden" name="index" value="<%= i %>">
<button class="delete">Hapus</button>
</form>

</div>
<% }) %>
</div>
</div>

</div>

</div>

</body>
</html>
