<!DOCTYPE html>
<html>
<head>
<title>Login</title>
<style>
body{background:#0f172a;color:#fff;display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif}
form{background:#1e293b;padding:30px;border-radius:10px}
input,button{display:block;margin:10px 0;padding:10px;width:200px}
button{background:#22c55e;border:none;color:#000}
</style>
</head>
<body>
<form method="POST">
<h2>LOGIN ADMIN</h2>
<input name="id" placeholder="ID" required>
<input name="password" type="password" placeholder="Password" required>
<button>LOGIN</button>
</form>
</body>
</html>
